# Copy this file to .env and fill in your values. Never commit .env.

# Stripe secret key: Stripe Dashboard → Developers → API keys.
# Use sk_test_... while testing, then switch to sk_live_... to take real payments.
STRIPE_SECRET_KEY=sk_test_replace_me

# Webhook signing secret (whsec_...): Stripe Dashboard → Developers → Webhooks → your endpoint.
# Optional, but needed to record paid enrollments automatically.
STRIPE_WEBHOOK_SECRET=

# Password your admin types to open the site (any username works). Strongly recommended.
ADMIN_PASSWORD=

# The site's public address, e.g. https://sales-course-enrollment.onrender.com
# Stripe sends the admin back here after paying. Leave empty when running locally.
PUBLIC_URL=

# Where paid enrollments are logged by the webhook (one JSON object per line).
ENROLLMENTS_FILE=data/enrollments.jsonl

PORT=3000
